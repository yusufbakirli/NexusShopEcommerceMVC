@model Tez.MvcWebUI.Models.ShippingDetails
@{
    ViewBag.Title = "Siparişinizi Tamamlayın!";
}

<style>
    .field-validation-error {
        color: #f00;
    }

    .field-validation-valid {
        display: none;
    }

    .input-validation-error {
        border: 1px solid #f00;
        background-color: #fee
    }

    .validation-summary-errors {
        font-weight: bold;
        color: #f00;
    }

    .validation-summary-valid {
        display: none;
    }
</style>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h2>Sipariş Bilgileriniz</h2>
            <p>Lütfen sipariş bilgilerinizi doldurunuz.</p>
            <hr />

            @using (Html.BeginForm())
            {
                @Html.ValidationSummary()

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Kullanıcı Adı:</label>
                    <div class="col-sm-6">
                        <span class="bg-danger text-white px-1">
                            @User.Identity.Name
                        </span>
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Ad:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Ad, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Soyad:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Soyad, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Telefon Numarası:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Numara, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Adres Başlığı:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.AdresBasligi, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Adres:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Adres, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Şehir:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Sehir, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">İlçe:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.Ilce, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label">Posta Kodu:</label>
                    <div class="col-sm-6">
                        @Html.TextBoxFor(x => x.PostaKodu, new { @class = "form-control" })
                    </div>
                </div>

                <div class="row mb-3">
                    <label class="col-sm-2 col-form-label"></label>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary">Onayla</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>