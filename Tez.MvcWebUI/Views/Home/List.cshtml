@using Tez.MvcWebUI.Models
@model IEnumerable<ProductModel>
@{
    ViewBag.Title = "Ürünler";
}

<div class="container pb-5">
    <div class="row">
        <div class="col-md-2">
            @Html.Action("GetCategories", "Home")
        </div>
        <div class="col-md-10">

            @if (!string.IsNullOrEmpty(Request.QueryString["query"]))
            {
                <div class="alert alert-light" role="alert">
                    "<strong>@Request.QueryString["query"]</strong>" arama terimiyle <strong>@Model.Count()</strong> ürün bulundu.
                </div>
            }
            else
            {
                if (Model.Count() == 0)
                {
                    <div class="alert alert-light" role="alert">
                        Bu kategoride hiç ürün bulunamadı.
                    </div>
                }
                else
                {
                    <div class="alert alert-light" role="alert">
                        Bu kategoride <strong>@Model.Count()</strong> ürün bulundu.
                    </div>
                }
            }



            @Html.Partial("_ProductList", Model)
        </div>
    </div>
</div>